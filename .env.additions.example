# Add / adjust these in your project's real .env file

APP_NAME="Numis"
APP_URL=https://your-domain.tld

# Bulgarian is the default public language; English is the fallback used
# when a coin/series has no Bulgarian (or German) translation yet — this
# matters because the data imported from WordPress is currently English-only.
APP_LOCALE=bg
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=numis
DB_USERNAME=numis
DB_PASSWORD=change-me

FILESYSTEM_DISK=public

# Used once by database/seeders/AdminUserSeeder.php to create the first admin login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# DeepL Free API — used to translate Bulgarian coin text into English/German on create
DEEPL_API_KEY=
